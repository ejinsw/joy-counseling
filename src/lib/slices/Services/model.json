{
  "id": "services",
  "type": "SharedSlice",
  "name": "Services",
  "description": "Services offered by the counseling practice",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": "Our Services"
          }
        },
        "subtitle": {
          "type": "Text",
          "config": {
            "label": "Subtitle",
            "placeholder": "Professional counseling services to help you heal and grow"
          }
        }
      },
      "items": {
        "image": {
          "type": "Image",
          "config": {
            "label": "Service Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Service Title",
            "placeholder": "Individual Therapy"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Service Description",
            "placeholder": "Describe what this service offers and how it helps clients",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading1,heading2,heading3,strong,em,hyperlink,embed,list-item"
          }
        },
        "icon": {
          "type": "Select",
          "config": {
            "label": "Service Icon",
            "placeholder": "",
            "options": [
              "heart",
              "brain",
              "conversation",
              "growth",
              "family",
              "couple",
              "mindfulness",
              "wellness",
              "christ",
              "animal"
            ]
          }
        }
      }
    }
  ]
}